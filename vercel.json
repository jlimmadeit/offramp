{
  "buildCommand": "cd flowdify && npm install && npm run build",
  "outputDirectory": "flowdify/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/bundle/:path*", "destination": "/api/bundle/[...path]" },
    { "source": "/api/flowstage/:path*", "destination": "/api/flowstage/[...path]" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
