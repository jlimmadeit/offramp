{
  "buildCommand": "cd flowdify && npm install && npm run build",
  "outputDirectory": "flowdify/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/bundle/(.*)", "destination": "/api/bundle/[...path]?path=$1" },
    { "source": "/api/flowstage/(.*)", "destination": "/api/flowstage/[...path]?path=$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
